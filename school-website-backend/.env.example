# Backend environment variables (template)
# Copy to `.env` (which is gitignored) and fill in real values for local dev,
# or set these in your host/Render dashboard for deployment.
#
# For local runs, `./gradlew bootRun` auto-loads this file's values from `.env`
# (see build.gradle). Real OS environment variables take precedence over .env.

# ── Gmail SMTP (App Password, NOT your account password) ──────────────────────
# Generate at: https://myaccount.google.com/apppasswords
SPRING_MAIL_USERNAME=your-email@gmail.com
SPRING_MAIL_PASSWORD=your-16-char-app-password

# ── One-time full reseed of Pioneer ───────────────────────────────────────────
# Set to true for ONE boot to wipe & re-seed the 'pioneer' tenant with the latest
# full dataset, then set back to false (otherwise it wipes on every restart).
# SEED_FORCE_REFRESH=true

# ── PostgreSQL (production / prod profile only) ───────────────────────────────
# Not needed for local H2 dev. Used when SPRING_PROFILES_ACTIVE=prod.
# DB_HOST=your-db-host.render.com
# DB_PORT=5432
# DB_NAME=school_saas_db
# DB_USER=your-db-user
# DB_PASSWORD=your-db-password
